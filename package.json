{
  "name": "web-queen",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "turbo run check",
    "gen:tokens": "tsx scripts/gen-tokens-css.ts",
    "gen:tokens:check": "tsx scripts/gen-tokens-css.ts --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.16.0",
    "@types/node": "^26.6.5",
    "eslint": "^9.16.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "prettier": "^3.4.2",
    "prettier-plugin-svelte": "^3.3.2",
    "svelte-eslint-parser": "^1.9.0",
    "tsx": "^4.23.15",
    "turbo": "^2.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.18.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
